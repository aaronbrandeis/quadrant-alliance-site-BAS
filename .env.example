# Copy to .env.local for local dev. In production these live in the Vercel
# dashboard under Settings > Environment Variables.

# --- contact form ------------------------------------------------------
# From resend.com > API Keys. Without it the form shows a visible error and
# a fallback address; it never claims to have sent what it did not send.
RESEND_API_KEY=

# Where submissions land. Comma-separate for several recipients.
CONTACT_TO=aaron@mainstaypartners.com

# The sending address. Must be on a domain verified in Resend.
# send.quadrantservice.com is already verified with SPF and DKIM, which is
# what keeps these out of spam. Only the recipients see this address: the
# API route sets reply-to to the enquirer's own email.
CONTACT_FROM=Quadrant Alliance <notifications@send.quadrantservice.com>

# --- site --------------------------------------------------------------
# Canonical origin, no trailing slash. Feeds canonical tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://quadrant-alliance-site.vercel.app

# Whether search engines may index the site. Anything other than the exact
# string "true" leaves it blocked. Deliberately unset in production while
# the site is still being iterated on.
NEXT_PUBLIC_INDEXABLE=
